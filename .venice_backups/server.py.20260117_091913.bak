import os
import json
from http.server import HTTPServer, SimpleHTTPRequestHandler
from urllib.parse import urlparse, quote, unquote

# Configuration
PORT = 8001
IMAGES_DIR = './images'
IMAGE_EXTENSIONS = {'.jpg', '.jpeg', '.png', '.gif', '.webp', '.bmp', '.svg', '.avif'}

class GalleryHandler(SimpleHTTPRequestHandler):
    def do_GET(self):
        parsed_path = urlparse(self.path)
        
        # API endpoint to get image list
        if parsed_path.path == '/api/images':
            self.send_image_list()
            return
        
        # Serve static files
        super().do_GET()
    
    def send_image_list(self):
        """Send JSON list of images in the images directory"""
        try:
            # Get absolute path to images directory
            images_dir = os.path.abspath(IMAGES_DIR)
            
            if not os.path.exists(images_dir):
                self.send_response(404)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({'error': 'Images directory not found'}).encode())
                return
            
 # Get all image files
 images = []
 for filename in sorted(os.listdir(images_dir)):
 ext = os.path.splitext(filename)[1].lower()
 if ext in IMAGE_EXTENSIONS:
 images.append(f'/images/{quote(filename)}')
            
            # Send JSON response
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()
            self.wfile.write(json.dumps(images).encode())
            
        except Exception as e:
            self.send_response(500)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({'error': str(e)}).encode())
    
    def translate_path(self, path):
        """Translate path to serve images from the images directory"""
        # Default translation
        translated = super().translate_path(path)
        
        # If requesting an image, serve from images directory
        if path.startswith('/images/'):
            images_dir = os.path.abspath(IMAGES_DIR)
            filename = unquote(path[8:])  # Remove '/images/' prefix
            translated = os.path.join(images_dir, filename)
        
        return translated

if __name__ == '__main__':
    os.chdir(os.path.dirname(os.path.abspath(__file__)))
    print(f"Lightbox Gallery Server running on http://localhost:{PORT}")
    print(f"Serving images from: {os.path.abspath(IMAGES_DIR)}")
    print("Press Ctrl+C to stop")
    
    try:
        HTTPServer(('localhost', PORT), GalleryHandler).serve_forever()
    except KeyboardInterrupt:
        print("\nServer stopped")
        }
        .btn-local { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        .btn-web { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; }
        .btn:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
        .icon { font-size: 48px; margin-bottom: 10px; display: block; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Image Gallery</h1>
        <p class="subtitle">Choose your gallery type</p>
        <div class="buttons">
            <a href="/local" class="btn btn-local">
                <span class="icon">📁</span>
                Local Gallery
            </a>
            <a href="/web" class="btn btn-web">
                <span class="icon">🌐</span>
                Web Gallery
            </a>
        </div>
    </div>
</body>
</html>'''
        self.send_html(html)
    
    def send_web_form(self, error=''):
        error_html = f'<div class="error">{error}</div>' if error else ''
        html = f'''<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web Gallery</title>
    <style>
        * {{ margin: 0; padding: 0; box-sizing: border-box; }}
        body {{
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }}
        .container {{
            text-align: center;
            background: white;
            padding: 60px 40px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);

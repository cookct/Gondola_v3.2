/* --- Themes --- */

/* Hacker Console (Default) */
.theme-hacker body,
body.theme-hacker {
    background-color: var(--bg-dark) !important;
    background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('../images/matrix1.png') !important;
    background-size: cover !important;
    background-position: center !important;
    background-attachment: fixed !important;
}

.theme-hacker #matrix-rain,
body.theme-hacker #matrix-rain {
    display: none;
}

/* Matrix Console - animated canvas */
.theme-matrix body,
body.theme-matrix {
    background-color: #020812;
    background-image: none;
}

.theme-matrix #matrix-rain,
body.theme-matrix #matrix-rain {
    display: block;
    height: 100vh;
    overflow: hidden;
}

/* Light Mode */
.theme-light body,
body.theme-light {
    background-color: #f3f4f6;
    background-image: none;
    color: #1f2937;
    --bg-dark: #ffffff;
    --bg-darker: #f9fafb;
    --bg-light: #f3f4f6;
    --text-main: #1f2937;
    --text-dim: #6b7280;
    --border: #e5e7eb;
    --user-msg-bg: #e5e7eb;
    --assistant-msg-bg: #ffffff;
    --modal-bg: #ffffff;
}

.theme-light #matrix-rain {
    display: none;
}

/* Dark Mode (Simple) */
.theme-dark body,
body.theme-dark {
    background-color: #1e1e1e;
    background-image: none;
}

.theme-dark #matrix-rain {
    display: none;
}

# Gondola v2.2 - Environment Variables
# Copy this file to .env and fill in your API keys

# Venice AI API Key (optional - for Venice-hosted models)
# Get yours at: https://venice.ai/settings/api
VENICE_API_KEY=your_venice_api_key_here

# Together AI API Key (required - for Together-hosted models including Kimi K2.5)
# Get yours at: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your_together_api_key_here

# Optional: Custom config path
# VENICE_CONFIG_PATH=~/.venice_config.json

let keywordCount = 1;

function addKeyword() {
    const container = document.getElementById('keywordContainer');
    const newRow = document.createElement('div');
    newRow.className = 'keyword-row';
    newRow.innerHTML = '<select class="keyword-operator"><option value="">(none)</option><option value="AND">AND</option><option value="OR">OR</option><option value="NOT">NOT</option></select><input type="text" class="keyword-input" placeholder="Enter keyword"><button type="button" class="btn-remove" onclick="removeKeyword(this)">x</button>';
    container.appendChild(newRow);
    keywordCount++;
    updateRemoveButtons();
}

function removeKeyword(button) {
    const row = button.closest('.keyword-row');
    row.remove();
    keywordCount--;
    updateRemoveButtons();
}

function updateRemoveButtons() {
    const rows = document.querySelectorAll('.keyword-row');
    rows.forEach((row) => {
        const removeBtn = row.querySelector('.btn-remove');
        if (removeBtn) {
            removeBtn.style.display = rows.length > 1 ? 'block' : 'none';
        }
    });
}

function buildDork() {
    const keywordRows = document.querySelectorAll('.keyword-row');
    let keywords = [];
    let hasKeyword = false;

    keywordRows.forEach((row, index) => {
        const operator = row.querySelector('.keyword-operator').value;
        const keyword = row.querySelector('.keyword-input').value.trim();
        if (keyword) {
            hasKeyword = true;
            if (operator && index > 0) {
                keywords.push(operator + ' ' + keyword);
            } else {
                keywords.push(keyword);
            }
        }
    });

    if (!hasKeyword) {
        alert('Please enter at least one keyword');
        return false;
    }

    let dork = keywords.join(' ');

    const site = document.getElementById('site').value.trim();
    if (site) {
        dork += ' site:' + site;
    }

    const filetypes = [];
    document.querySelectorAll('.checkbox-group input[type="checkbox"]:checked').forEach(checkbox => {
        filetypes.push(checkbox.value);
    });
    if (filetypes.length > 0) {
        dork += ' filetype:(' + filetypes.join('|') + ')';
    }

    const inurl = document.getElementById('inurl').value.trim();
    if (inurl) {
        dork += ' inurl:' + inurl;
    }

    const intitle = document.getElementById('intitle').value.trim();
    if (intitle) {
        dork += ' intitle:"' + intitle + '"';
    }

    const intext = document.getElementById('intext').value.trim();
    if (intext) {
        dork += ' intext:"' + intext + '"';
    }

    const exclude = document.getElementById('exclude').value.trim();
    if (exclude) {
        dork += ' ' + exclude;
    }

    const encodedDork = encodeURIComponent(dork);
    const googleUrl = 'https://www.google.com/search?q=' + encodedDork;

    document.getElementById('resultUrl').textContent = dork;
    document.getElementById('searchLink').href = googleUrl;
    document.getElementById('resultBox').style.display = 'block';

    return false;
}

function clearForm() {
    document.getElementById('dorkForm').reset();
    document.getElementById('resultBox').style.display = 'none';
    const container = document.getElementById('keywordContainer');
    container.innerHTML = '<div class="keyword-row"><select class="keyword-operator"><option value="">(none)</option><option value="AND">AND</option><option value="OR">OR</option><option value="NOT">NOT</option></select><input type="text" class="keyword-input" placeholder="Enter keyword" required><button type="button" class="btn-remove" onclick="removeKeyword(this)" style="display: none;">x</button></div>';
    keywordCount = 1;
}

document.getElementById('dorkForm').addEventListener('submit', function(e) {
    e.preventDefault();
    buildDork();
});
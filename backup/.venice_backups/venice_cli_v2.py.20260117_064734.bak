# Symlink handling modes
SYMLINK_ALLOW = "allow"  # Allow symlinks without restrictions
SYMLINK_DENY = "deny"   # Deny all symlinks
SYMLINK_FOLLOW = "follow"  # Allow symlinks but validate target is within workspace
DEFAULT_SYMLINK_MODE = SYMLINK_FOLLOW

